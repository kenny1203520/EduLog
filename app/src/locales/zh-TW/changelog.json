{
    "entries": [
        {
            "version": "1.1.1",
            "date": "2026-05-03",
            "changes": {
                "added": [
                    "實裝具備多國語言支援的報告編輯器組件。",
                    "整合學生報告檢視功能，可查看歷史數據。",
                    "在課堂詳情中整合跨瀏覽器剪貼簿工具。"
                ],
                "changed": [
                    "重構行事曆相關組件，優化日期處理與 UI 一致性。",
                    "優化課程指令服務，提升課堂管理穩定性。"
                ],
                "fixed": [
                    "移除計算狀態時未使用的變數。"
                ]
            }
        },
        {
            "version": "1.1.0",
            "date": "2026-05-02",
            "changes": {
                "added": [
                    "新增教室管理與課堂詳情檢視，集中化資源管理。",
                    "新增報告管理系統的英文與繁體中文本地化支援。",
                    "新增教師管理功能，包含搜尋、選擇與出勤追蹤。",
                    "新增教學排程管理與增強的教師指派處理。",
                    "在教師管理中新增透過 Email 搜尋使用者的功能。",
                    "在出勤與報告系統中整合休假日管理。",
                    "在課堂與教師指派中支援開始與結束日期。"
                ],
                "changed": [
                    "升級資料庫並新增自定義 Kong 網關以處理 JWT。",
                    "大幅重構服務架構，將服務組織到專門的領域目錄中。",
                    "重構核心服務以遵循 CQRS（命令查詢職責分離）模式。",
                    "增強課程、報告與教師的多國語言支援。"
                ],
                "fixed": [
                    "改進教師管理中重複使用者的錯誤處理。",
                    "增強休假日期間更新出勤的驗證與錯誤訊息。"
                ]
            }
        },
        {
            "version": "1.0.1",
            "date": "2026-04-21",
            "changes": {
                "added": [
                    "在課堂紀錄中新增狀態與教室詳情。",
                    "新增課程進度與摘要功能。",
                    "在課堂詳情檢視中新增教學日期導覽。",
                    "新增可自定義的出勤與課程複製範本。"
                ],
                "changed": [
                    "改進課堂詳情的響應式佈局，提升行動裝置可用性。",
                    "增強報告編輯器的自動儲存功能。",
                    "更新行事曆組件以支援緊湊視圖並改進導覽。",
                    "在課堂詳情中提升字體大小與易讀性。"
                ],
                "fixed": [
                    "修正 Row Level Security (RLS) 權限原則。",
                    "修正「未找到課程」訊息的顯示條件。"
                ]
            }
        },
        {
            "version": "1.0.0",
            "date": "2026-04-16",
            "changes": {
                "added": [
                    "EduLog 正式發佈。",
                    "核心學習報告管理與同步功能。",
                    "即時學生出勤追蹤。"
                ]
            }
        }
    ]
}