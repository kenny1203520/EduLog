# EduLog frontend: local development env. Copy to app/.env (or .env.local).
# Only VITE_* keys reach the browser bundle; never put secrets or Supabase keys
# in them. The other keys configure the Vite dev/preview server only and
# override the repo-root .env. Full reference: docs/deployment/environment.md

# Browser API mode: mock (local fake data) | legacy | v1 (Express /api).
# Production containers default to v1 through the nginx runtime config.
VITE_API_V1_MODE=mock
# Base URL for legacy mode.
VITE_LEGACY_API_BASE_URL=/api

# Dev server only: where Vite proxies /api (the Express API from `npm run dev` in server/).
EDULOG_API_DEV_TARGET=http://localhost:3000
