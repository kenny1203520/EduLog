{
  "manifest_version": 3,
  "name": "EduLog Teaching Tools",
  "description": "Improve teaching system workflows with EduLog.",
  "version": "0.1.0",
  "minimum_chrome_version": "125",
  "action": {
    "default_title": "EduLog",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://corp.orangeapple.co/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://corp.orangeapple.co/*"
      ],
      "js": [
        "shared/runtime-bridge.js",
        "sites/orange-apple/orange-apple-lexicon.js",
        "sites/orange-apple/orange-apple-model.js",
        "sites/orange-apple/orange-apple.js",
        "content/bootstrap.js"
      ],
      "css": [
        "styles/edulog-tokens.css",
        "sites/orange-apple/orange-apple.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://corp.orangeapple.co/*"
      ],
      "js": [
        "shared/ui-core.js",
        "shared/ui-messages.js",
        "shared/source-date.js",
        "shared/field-mappings.js",
        "shared/field-mapping-ui.js",
        "shared/connection-ui.js",
        "shared/integration-ui.js",
        "sites/orange-apple/orange-apple-todo.js",
        "sites/orange-apple/orange-apple-session-cards.js",
        "sites/orange-apple/orange-apple-attendance-export.js",
        "sites/orange-apple/orange-apple-quick-attendance.js",
        "sites/orange-apple/orange-apple-accounts.js",
        "sites/orange-apple/orange-apple-navigation.js",
        "sites/orange-apple/orange-apple-report-editor.js",
        "sites/orange-apple/orange-apple-roster.js",
        "sites/orange-apple/orange-apple-workflows.js",
        "sites/orange-apple/orange-apple-integration.js",
        "content/editor-prefill.js",
        "content/content.js"
      ],
      "css": [
        "content/dialog-layout.css",
        "content/editor-prefill.css"
      ],
      "run_at": "document_end"
    }
  ]
}
