{
  "manifest_version": 3,
  "name": "EduLog Teaching Tools",
  "description": "Improve teaching system workflows with EduLog.",
  "version": "0.1.0",
  "minimum_chrome_version": "125",
  "action": {
    "default_title": "EduLog",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://corp.orangeapple.co/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://corp.orangeapple.co/*"
      ],
      "js": [
        "shared/runtime-bridge.js",
        "sites/orange-apple/core/lexicon.js",
        "sites/orange-apple/core/model.js",
        "sites/orange-apple/core/adapter.js",
        "content/bootstrap.js"
      ],
      "css": [
        "styles/edulog-tokens.css",
        "sites/orange-apple/site.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://corp.orangeapple.co/*"
      ],
      "js": [
        "shared/ui-core.js",
        "shared/ui-messages.js",
        "shared/ui-phrases.js",
        "shared/source-date.js",
        "shared/field-mappings.js",
        "shared/field-mapping-ui.js",
        "shared/connection-ui.js",
        "shared/integration-ui.js",
        "sites/orange-apple/features/todo.js",
        "sites/orange-apple/features/session-cards.js",
        "sites/orange-apple/features/attendance-export.js",
        "sites/orange-apple/features/quick-attendance.js",
        "sites/orange-apple/features/accounts.js",
        "sites/orange-apple/core/navigation.js",
        "sites/orange-apple/features/report-editor.js",
        "sites/orange-apple/features/roster.js",
        "sites/orange-apple/features/renewal-status.js",
        "sites/orange-apple/pages/common.js",
        "sites/orange-apple/pages/hours.js",
        "sites/orange-apple/pages/profile.js",
        "sites/orange-apple/pages/class.js",
        "sites/orange-apple/pages/report-table.js",
        "sites/orange-apple/pages/history.js",
        "sites/orange-apple/pages/unfilled.js",
        "sites/orange-apple/pages/renewals.js",
        "sites/orange-apple/pages/sign-in.js",
        "sites/orange-apple/pages/classes.js",
        "sites/orange-apple/pages/overview.js",
        "sites/orange-apple/pages/calendar.js",
        "sites/orange-apple/pages/dialogs.js",
        "sites/orange-apple/pages/index.js",
        "sites/orange-apple/integration/integration.js",
        "content/editor-prefill.js",
        "content/content.js"
      ],
      "css": [
        "content/dialog-layout.css",
        "content/editor-prefill.css"
      ],
      "run_at": "document_end"
    }
  ]
}
