##########################################################################
# Supabase upstream (synced from supabase/.env.example - do not edit here;
# change supabase/.env.example and copy it over). Names are Supabase's own.
# EduLog's settings start at "EduLog: required" below.
##########################################################################

############
# Secrets
#
# YOU MUST CHANGE ALL THE DEFAULT VALUES BELOW BEFORE STARTING
# THE CONTAINERS FOR THE FIRST TIME!
#
# Documentation:
# https://supabase.com/docs/guides/self-hosting/docker#configuring-and-securing-supabase
#
# To generate secrets and API keys:
# sh ./utils/generate-keys.sh
#
############

# Postgres
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# Legacy symmetric HS256 key
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
# Legacy API keys (HS256-signed JWTs)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Asymmetric key pair (ES256) and opaque API keys
#
# Documentation:
# https://supabase.com/docs/guides/self-hosting/self-hosted-auth-keys
#
# To generate:
# sh ./utils/add-new-auth-keys.sh
#
# Opaque API key for client-side use (anon role).
SUPABASE_PUBLISHABLE_KEY=
# Opaque API key for server-side use (service_role). Never expose in client code.
SUPABASE_SECRET_KEY=
# JSON array of signing JWKs (EC private + legacy symmetric).
# Used by Auth.
JWT_KEYS=
# JWKS for token verification (EC public + legacy symmetric).
# Used by PostgREST, Realtime, Storage to verify tokens.
JWT_JWKS=

# Access to Dashboard
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

# Used by Realtime and Supavisor
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq

# Used by Realtime to encrypt tenant secrets. Exactly 16 characters.
# Existing installs must keep "supabaserealtime".
REALTIME_DB_ENC_KEY=supabaserealtime

# Used by Supavisor
VAULT_ENC_KEY=your-32-character-encryption-key

# Used by Studio to access Postgres via postgres-meta
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

# Analytics - API tokens for log ingestion/querying, and for management
LOGFLARE_PUBLIC_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-public
LOGFLARE_PRIVATE_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-private

# Access to Storage via S3 protocol endpoint (see below)
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907


############
# URLs - Configure hostnames below to reflect your actual domain name
############

# Access to Dashboard and REST API
SUPABASE_PUBLIC_URL=http://localhost:8000

# Full external URL of the Auth service, used to construct OAuth callbacks,
# SAML endpoints, and email links. Includes the /auth/v1 path prefix and is
# also used as the JWT issuer (GOTRUE_JWT_ISSUER).
API_EXTERNAL_URL=http://localhost:8000/auth/v1

# See also the Auth section below for Site URL and Redirect URLs configuration


############
# Database - Postgres configuration
############

# Using default user (postgres)
POSTGRES_HOST=db
POSTGRES_DB=postgres

# Default configuration includes Supavisor exposing POSTGRES_PORT
# Postgres uses POSTGRES_PORT inside the container
# Documentation:
# https://supabase.com/docs/guides/self-hosting/docker#accessing-postgres-through-supavisor
POSTGRES_PORT=5432


############
# Supavisor - Database pooler
############

# Supavisor exposes POSTGRES_PORT and POOLER_PROXY_PORT_TRANSACTION,
# POSTGRES_PORT is used for session mode pooling
#
# Port to use for transaction mode pooling connections
POOLER_PROXY_PORT_TRANSACTION=6543

# Maximum number of PostgreSQL connections Supavisor opens per pool
POOLER_DEFAULT_POOL_SIZE=20

# Maximum number of client connections Supavisor accepts per pool
POOLER_MAX_CLIENT_CONN=100

# Unique Supavisor tenant identifier
# Documentation:
# https://supabase.com/docs/guides/self-hosting/docker#accessing-postgres
POOLER_TENANT_ID=your-tenant-id

# Pool size for internal metadata storage used by Supavisor
# This is separate from client connections and used only by Supavisor itself
POOLER_DB_POOL_SIZE=5


############
# Studio - Configuration for the Dashboard
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

# Add your OpenAI API key to enable AI Assistant
OPENAI_API_KEY=sk-proj-xxxxxxxx


############
# Auth - Configuration for the authentication server
############

## General settings

# Equivalent to "Site URL" and "Redirect URLs" platform configuration options
# Documentation: https://supabase.com/docs/guides/auth/redirect-urls
# The EduLog web address (same as EDULOG_WEB_BASE_URL): email links ({{ .SiteURL }}) open here.
SITE_URL=https://edulog.example.com
# Must include ${EDULOG_WEB_BASE_URL}/api/auth/oauth/callback for OAuth sign-in.
ADDITIONAL_REDIRECT_URLS=https://edulog.example.com/api/auth/oauth/callback

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

## Mailer Config
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

## OAuth / Social login providers

## OAuth / social sign-in. Enable any provider GoTrue supports; the login
## page lists the enabled ones. Register ${API_EXTERNAL_URL}/callback as the
## redirect/callback URL at each provider. New OAuth accounts wait for an
## administrator to approve them (System settings > Account approval).
APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_SECRET=
AZURE_ENABLED=false
AZURE_CLIENT_ID=
AZURE_SECRET=
AZURE_URL=
BITBUCKET_ENABLED=false
BITBUCKET_CLIENT_ID=
BITBUCKET_SECRET=
DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_SECRET=
FACEBOOK_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_SECRET=
FIGMA_ENABLED=false
FIGMA_CLIENT_ID=
FIGMA_SECRET=
FLY_ENABLED=false
FLY_CLIENT_ID=
FLY_SECRET=
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_SECRET=
GITLAB_ENABLED=false
GITLAB_CLIENT_ID=
GITLAB_SECRET=
GITLAB_URL=
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
KAKAO_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_SECRET=
KEYCLOAK_ENABLED=false
KEYCLOAK_CLIENT_ID=
KEYCLOAK_SECRET=
KEYCLOAK_URL=
LINKEDIN_OIDC_ENABLED=false
LINKEDIN_OIDC_CLIENT_ID=
LINKEDIN_OIDC_SECRET=
NOTION_ENABLED=false
NOTION_CLIENT_ID=
NOTION_SECRET=
SLACK_OIDC_ENABLED=false
SLACK_OIDC_CLIENT_ID=
SLACK_OIDC_SECRET=
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_SECRET=
TWITCH_ENABLED=false
TWITCH_CLIENT_ID=
TWITCH_SECRET=
TWITTER_ENABLED=false
TWITTER_CLIENT_ID=
TWITTER_SECRET=
WORKOS_ENABLED=false
WORKOS_CLIENT_ID=
WORKOS_SECRET=
WORKOS_URL=
ZOOM_ENABLED=false
ZOOM_CLIENT_ID=
ZOOM_SECRET=

# Phone / SMS provider configuration
# Uncomment to configure SMS delivery for phone auth and phone MFA.
# You must ALSO uncomment the matching GOTRUE_SMS_* lines in docker-compose.yml
# Documentation: https://supabase.com/docs/guides/self-hosting/self-hosted-phone-mfa
# SMS_PROVIDER=twilio
# SMS_OTP_EXP=60
# SMS_OTP_LENGTH=6
# SMS_MAX_FREQUENCY=60s
# SMS_TEMPLATE=Your code is {{ .Code }}

# SMS_TWILIO_ACCOUNT_SID=
# SMS_TWILIO_AUTH_TOKEN=
# SMS_TWILIO_MESSAGE_SERVICE_SID=

# Test OTP: map phone numbers to fixed OTP codes for development
# Format: phone1:code1,phone2:code2
# SMS_TEST_OTP=

# Multi-factor authentication (MFA)
# Uncomment to change MFA defaults.
# You must ALSO uncomment the matching GOTRUE_MFA_* lines in docker-compose.yml

# App Authenticator (TOTP) - enabled by default
# MFA_TOTP_ENROLL_ENABLED=true
# MFA_TOTP_VERIFY_ENABLED=true

# Phone MFA - disabled by default (opt-in)
# MFA_PHONE_ENROLL_ENABLED=false
# MFA_PHONE_VERIFY_ENABLED=false

# Maximum MFA factors a user can enroll
# MFA_MAX_ENROLLED_FACTORS=10

## SAML SSO

# You must ALSO uncomment the matching GOTRUE_* lines in docker-compose.yml
# Documentation: https://supabase.com/docs/guides/self-hosting/self-hosted-saml-sso

# SAML_ENABLED=true
# SAML_PRIVATE_KEY=<your-base64-encoded-private-key>

# Optional: accept encrypted SAML assertions from IdPs (default: false)
# SAML_ALLOW_ENCRYPTED_ASSERTIONS=false

# Optional: how long relay state tokens remain valid (default: 2m0s)
# SAML_RELAY_STATE_VALIDITY_PERIOD=2m0s

# Optional: override the SAML entity ID / ACS base URL
# Defaults to API_EXTERNAL_URL if not set
# SAML_EXTERNAL_URL=https://supabase.example.com:8000

# Optional: rate limit on the ACS endpoint (requests per second, default: 15)
# SAML_RATE_LIMIT_ASSERTION=15


############
# Storage - Configuration for Storage
############

# Check the S3_PROTOCOL_ACCESS_KEY_ID/SECRET above, and
# refer to the documentation at:
# https://supabase.com/docs/guides/self-hosting/self-hosted-s3
# to learn how to configure the S3 protocol endpoint

# S3 bucket when using S3 backend, directory name when using 'file'
GLOBAL_S3_BUCKET=stub

# Used for S3 protocol endpoint configuration
REGION=stub

# Used by MinIO when added via:
# docker compose -f docker-compose.yml -f docker-compose.s3.yml up -d
MINIO_ROOT_USER=supa-storage
MINIO_ROOT_PASSWORD=secret1234

# Equivalent to project_ref as described here:
# https://supabase.com/docs/guides/storage/s3/authentication#session-token
STORAGE_TENANT_ID=stub


############
# API - Configuration for PostgREST
############

# Postgres schemas exposed via the REST API
PGRST_DB_SCHEMAS=public,graphql_public

# Max number of rows returned by a request
PGRST_DB_MAX_ROWS=1000

# Extra schemas added to the search_path of every request
PGRST_DB_EXTRA_SEARCH_PATH=public


############
# Analytics - Configuration for Logflare
############

# Optional: only used with supabase/docker-compose.logs.yml.
# Check the LOGFLARE_* access token configuration _above_.
# If Logflare has to be externally exposed - configure securely!

# Docker socket location - required for proper Vector operation
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
# For Podman use the following:
# DOCKER_SOCKET_LOCATION=/run/podman/podman.sock

# Google Cloud Project details
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER


############
# API gateway
############

# Host port the API gateway (Envoy by default) listens on; bound to 127.0.0.1.
API_GW_HTTP_PORT=8000

# Kong gateway override only (-f supabase/docker-compose.kong.yml). KONG_HTTPS_PORT is
# Kong's built-in HTTPS listener; KONG_HTTP_PORT is kept as a fallback for
# API_GW_HTTP_PORT so existing .env files continue to work.
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Used internally by the API gateway - DO NOT use in any client or server code.
# Pre-signed ES256 JWT "API key" for anon role.
ANON_KEY_ASYMMETRIC=
# Pre-signed ES256 JWT "API key" for service_role.
SERVICE_ROLE_KEY_ASYMMETRIC=


############
# imgproxy
############

# Enable webp support
IMGPROXY_AUTO_WEBP=true


############
# TLS Proxy - Optional Caddy or Nginx reverse proxy with Let's Encrypt
############

# Documentation:
# https://supabase.com/docs/guides/self-hosting/self-hosted-proxy-https

# Usage:
# docker compose -f docker-compose.yml -f docker-compose.caddy.yml up -d
# docker compose -f docker-compose.yml -f docker-compose.nginx.yml up -d

# Domain name for the proxy (must point to your server)
PROXY_DOMAIN=your-domain.example.com

# Email for Let's Encrypt certificate notifications (nginx only, Caddy uses PROXY_DOMAIN).
# This should be a valid email, not a placehoder (otherwise Certbot may fail to start).
CERTBOT_EMAIL=admin@example.com

##########################################################################
# EduLog: required
# Full reference and the name mapping into each container:
# docs/deployment/environment.md
##########################################################################

# Session cookie signing secret for the API, at least 32 characters
# (openssl rand -base64 32). The API refuses to start without it.
EDULOG_COOKIE_SECRET=
# Browser-facing EduLog frontend URL (HTTPS in production). Used for
# redirects and extension pairing.
EDULOG_WEB_BASE_URL=https://edulog.example.com
# Where GoTrue fetches the EduLog email templates (served by the api service).
EDULOG_MAIL_TEMPLATE_BASE_URL=http://api:3000/email-templates
# Exact web origins allowed to call the API with
# credentials, comma-separated. Production refuses to start when empty.
EDULOG_ALLOWED_ORIGINS=https://edulog.example.com

##########################################################################
# EduLog: optional (values are the defaults unless marked as an example)
##########################################################################

## Images
# Tag of all three EduLog images (edulog, edulog-api, edulog-presidio).
# alpha / beta / rc follow the newest prerelease of that channel, latest the
# newest stable release; set an exact version (e.g. 2.0.0-alpha.5) to pin.
EDULOG_IMAGE_TAG=alpha

## Frontend container (nginx)
# Host port mapped to the container's 4173 (nginx always listens on 4173).
EDULOG_PORT=4173
EDULOG_HTTPS_PORT=4174
# Host header allowlist for the frontend (not CORS; see EDULOG_ALLOWED_ORIGINS).
# Example value: empty (the default) accepts any Host, so set it in production.
EDULOG_ALLOWED_HOSTS=localhost,127.0.0.1,edulog.example.com
# Where the frontend nginx proxies /api.
EDULOG_API_UPSTREAM=api:3000
EDULOG_HTTP_ENABLED=true
EDULOG_HTTPS_ENABLED=false
EDULOG_HTTPS_REDIRECT=false
EDULOG_SSL_DIR=./ssl
EDULOG_SSL_CERT_PATH=/app/ssl/fullchain.pem
EDULOG_SSL_KEY_PATH=/app/ssl/privkey.pem
EDULOG_SSL_CA_PATH=
EDULOG_HSTS_HEADER=max-age=31536000; includeSubDomains; preload
# Leave empty to use the built-in policy. A custom policy must list the extension origins in its own
# frame-ancestors directive, or the extension side panel cannot show EduLog.
EDULOG_CSP_HEADER=
# Extension side panel: exact chrome-extension://<id> origins, SPACE-separated, that may frame the web
# app. Empty uses API_EXTENSION_ALLOWED_ORIGINS in the app container; the Caddy/nginx proxy variants
# need it set here. With neither set, no page may frame EduLog.
EDULOG_FRAME_ANCESTORS=

## TLS proxy overlays (supabase/docker-compose.caddy.yml / nginx.yml)
EDULOG_PROXY_DOMAIN=edulog.example.com
EDULOG_PROXY_UPSTREAM_URL=http://edulog:4173

## API container (Express)
NODE_ENV=production
# Supabase gateway as seen from inside the Compose network. "kong" is a network
# alias of the api-gw service, so it works with both Envoy and Kong.
EDULOG_SUPABASE_INTERNAL_URL=http://kong:8000
EDULOG_SUPABASE_REALTIME_URL=ws://kong:8000/realtime/v1/websocket
# Set false only when serving plain HTTP on localhost.
EDULOG_COOKIE_SECURE=true
# supabase | memory (memory is refused in production).
RATE_LIMIT_STORE=supabase
# Request body limit in Express syntax (512kb, 1mb); the frontend nginx converts it.
EDULOG_API_BODY_LIMIT=1mb
EDULOG_API_RATE_LIMIT_PER_MINUTE=120
# Exact extension origins only, COMMA-separated; e.g. chrome-extension://<extension-id>.
API_EXTENSION_ALLOWED_ORIGINS=

## AI report assistant
# AES-256-GCM key for stored provider credentials, 32 random bytes as base64
# (openssl rand -base64 32). Server-only. Keep it stable; rotating it makes
# stored credentials unreadable. Leave empty to keep AI credential storage disabled.
EDULOG_AI_SECRET_KEY=
# Presidio analyzer REST endpoint used to de-identify AI prompts,
# e.g. http://presidio-analyzer:3000 with the bundled service.
EDULOG_PRESIDIO_ANALYZER_URL=
# Languages the bundled Presidio analyzer loads at start (restart to change):
# ca, da, de, el, en, es, fi, fr, hr, it, ja, ko, lt, mk, nb, nl, pl, pt, ro,
# ru, sl, sv, uk, zh. An unknown code stops the container.
EDULOG_PRESIDIO_LANGUAGES=zh,en
# Sign in with ChatGPT plan usage (OpenAI-approved website client). Leave empty to keep it off.
EDULOG_OPENAI_SIWC_CLIENT_ID=
EDULOG_OPENAI_SIWC_CLIENT_SECRET=
