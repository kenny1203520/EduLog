{
  "name": "edulog-api",
  "private": true,
  "version": "2.0.0-alpha.8",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test:extension-db": "node ../supabase/tests/web_extension_workspace.mjs && node ../supabase/tests/source_report_identity.mjs",
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "bootstrap:system-owner": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/bin/bootstrapSystemOwner.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/google": "^4.0.114",
    "@ai-sdk/openai": "^4.0.111",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@supabase/supabase-js": "^2.119.0",
    "ai": "^7.0.166",
    "ai-sdk-ollama": "^4.6.3",
    "cookie-parser": "^1.4.7",
    "diff-match-patch": "^1.0.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.17",
    "nodemailer": "^10.4.0",
    "pino": "^10.4.0",
    "undici": "^7.30.2",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/cookie-parser": "^1.4.10",
    "@types/diff-match-patch": "^1.0.36",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
