NODE_ENV=development
API_PORT=3000
EDULOG_WEB_BASE_URL=
SUPABASE_URL=http://kong:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REALTIME_URL=ws://kong:8000/realtime/v1/websocket
COOKIE_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
RATE_LIMIT_STORE=supabase
API_BODY_LIMIT=1mb
API_ALLOWED_ORIGINS=
API_EXTENSION_ALLOWED_ORIGINS=
API_RATE_LIMIT_PER_MINUTE=120
# AI report assistant: AES-256-GCM key for stored provider credentials,
# 32 random bytes as base64 (openssl rand -base64 32). Keep it secret and
# stable; rotating it makes stored credentials unreadable.
AI_SECRET_KEY=
# Presidio analyzer REST endpoint used to de-identify AI prompts.
PRESIDIO_ANALYZER_URL=
# Sign in with ChatGPT plan usage (OpenAI-approved website client). Leave empty to keep it off.
OPENAI_SIWC_CLIENT_ID=
OPENAI_SIWC_CLIENT_SECRET=
