# EduLog API: local development env.
# Copy to `server/.env` (or `.env.local`, which overrides it). `npm run dev`
# loads both automatically; variables exported in the shell win over files.
# In Docker Compose these are set from the root `.env` instead; see
# docs/deployment/environment.md for the full reference and name mapping.

# --- Runtime -----------------------------------------------------------------
# development | test | production (production enforces HTTPS, explicit origins, supabase rate limits)
NODE_ENV=development
API_PORT=3000

# --- Required ----------------------------------------------------------------
# Browser-facing frontend origin (HTTPS outside localhost). Used for redirects.
EDULOG_WEB_BASE_URL=http://localhost:5173
# Supabase API gateway (Envoy or Kong). Inside Compose this is http://kong:8000
# (a network alias of the api-gw service).
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 characters: openssl rand -base64 32
COOKIE_SECRET=

# --- Optional ----------------------------------------------------------------
# Supabase JWT secret / issuer for local token checks (self-hosted only).
# The issuer, when set, must match API_EXTERNAL_URL (which ends in /auth/v1).
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
# Realtime websocket; defaults to SUPABASE_URL. Inside Compose: ws://kong:8000/realtime/v1/websocket
SUPABASE_REALTIME_URL=
# true behind HTTPS
COOKIE_SECURE=false
# supabase | memory. The schema default is supabase; memory is for local dev
# without the rate-limit RPC and is refused in production.
RATE_LIMIT_STORE=memory
# Express size syntax: 512kb, 1mb, ...
API_BODY_LIMIT=1mb
# Comma-separated exact web origins. Empty outside production = local Vite (port 5173).
API_ALLOWED_ORIGINS=
# Comma-separated chrome-extension://<32-char id> origins.
API_EXTENSION_ALLOWED_ORIGINS=
API_RATE_LIMIT_PER_MINUTE=120

# --- AI (optional) -----------------------------------------------------------
# AES-256-GCM key for stored provider credentials, 32 random bytes as base64
# (openssl rand -base64 32). Keep it secret and stable; rotating it makes
# stored credentials unreadable.
AI_SECRET_KEY=
# Presidio analyzer REST endpoint used to de-identify AI prompts.
PRESIDIO_ANALYZER_URL=
# Sign in with ChatGPT plan usage (OpenAI-approved website client). Leave empty to keep it off.
OPENAI_SIWC_CLIENT_ID=
OPENAI_SIWC_CLIENT_SECRET=
# Browser-facing Supabase gateway; OAuth sign-in redirects there. Empty = no OAuth.
SUPABASE_PUBLIC_URL=
# SMTP for notices about accounts waiting for approval. Empty host = no mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=
